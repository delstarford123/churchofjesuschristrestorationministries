# =================================================================
# RLDS Church Restoration Ministry - Backend Environment Variables
# Restoration Ministry Digital Sanctuary
# =================================================================

# Security & Tokens
SECRET_KEY=generate-a-strong-random-key-here-for-production
JWT_SECRET_KEY=generate-a-strong-jwt-secret-key-here-2026
JWT_EXPIRATION_HOURS=72

# Database Connection (Neon, Supabase, Vercel Postgres, or Railway PostgreSQL)
# Example: postgresql://username:password@ep-cold-pond.us-east-2.aws.neon.tech/rlds_church?sslmode=require
# If omitted, defaults to SQLite (/tmp/rlds_church.db on Vercel or local rlds_church.db)
DATABASE_URL=

# Default Super Admin Seed
INITIAL_ADMIN_EMAIL=admin@rldschurch.org
INITIAL_ADMIN_PASSWORD=Restoration2026!

# Email Service (Flask-Mail / SMTP) - Gmail / SendGrid / Amazon SES
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-church-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_DEFAULT_SENDER="RLDS Church Restoration Ministry <notifications@rldschurch.org>"

# Safaricom Daraja M-Pesa Settings
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_CALLBACK_URL=https://your-app.vercel.app/api/v1/tithes/mpesa/callback
ENABLE_MOCK_MPESA=true
